# Makefile.linux - POSIX build of the host.
#
#   make -f Makefile.linux        -> all of the below except host32
#   make -f Makefile.linux run    -> build letest-linux and run it on the game
#   make -f Makefile.linux host32 -> build/fd2host-linux32, the runnable host
#
# Targets:
#   letest-linux, platprobe-linux, doscheck-linux, faultprobe32/64
#     the cross-platform self checks (same assertions as the Windows tools)
#   fd2host-linux
#     64-bit link proof: every POSIX host file compiles and links. It cannot
#     run the game (the guest is 32-bit x86); use host32 for that.
#   host32 (fd2host-linux32)
#     the real host, -m32. Needs gcc-multilib + libc6-dev-i386 + the i386
#     X11/GL/ALSA dev packages. Verified on WSLg/XWayland: same-tick frame
#     diff against the Windows sokol/D3D11 build is 0 pixels
#     (docs/rounds/16-entry-layer.md §46.10).
#
# Same usage as the Windows letest.exe:
#   build/letest-linux <FD2.EXE> <reference-image-dir>
#
# Covered (docs/rounds/13-portability.md, 15-dos-and-faults.md,
# 16-entry-layer.md):
#   le.c / dos.c / platform_posix.c   loader, DOS services, OS seam
#   host.c / keylog.c / keys.c        the host kernel + key vocabulary
#   main_sokol.c / render_sokol.c     entry layer + GLCORE backend
#   the AIL/audio stack               ail/xmidi/synth/dls/audio_sokol
# The render backend is GL (SOKOL_GLCORE); windowing is sokol_app's X11
# backend, which runs on a Wayland desktop through XWayland (§13.11).
#
# Flags:
#   -std=gnu11      plain -c11 hides POSIX.1-2008 declarations the seam needs
#                   (clock/sigaltstack/gettid-era prototypes, ucontext's REG_*
#                   enum) - the same trap §43.6 hit with sokol; gnu11 turns on
#                   _DEFAULT_SOURCE.
#   -D_FILE_OFFSET_BITS=64   off_t must be 64-bit for pread/pwrite offsets
#                   once the game runs under -m32 (plain 32-bit off_t would
#                   cap file positions at 2 GiB).
#   -pthread         platform_posix.c's plat_thread
# faultprobe32 is freestanding (-m32 -nostdlib): it measures the i386 compat
# fault model *without* needing gcc-multilib installed.

CC      ?= cc
CFLAGS  ?= -O2 -g -std=gnu11 -Wall -D_FILE_OFFSET_BITS=64 -pthread
SRC     := src
OUT     := build
GAME    ?= /mnt/e/FD2/FD2.EXE
REFDIR  ?= /mnt/e/FD2/port/build

DOS_SRCS   := $(SRC)/dos.c $(SRC)/dos_fault_posix.c $(SRC)/le.c $(SRC)/platform_posix.c
PROBE32_CFLAGS := -m32 -O2 -g -ffreestanding -nostdlib -static -fno-pie -no-pie -Wall -Wextra

# The real host. It runs the original 32-bit guest code, so a *run* needs
# -m32; the 64-bit build below only proves that every host file compiles and
# links on POSIX (the guest cannot execute in a 64-bit process yet - see
# docs/rounds/16-entry-layer.md).
SOKOL      := vendor/sokol
GAME_SRCS  := $(SRC)/game/rle.c $(SRC)/game/gfx.c $(SRC)/game/sprite24.c \
              $(SRC)/game/util.c $(SRC)/game/path.c $(SRC)/game/tables.c \
              $(SRC)/game/rle2.c $(SRC)/game/dlg.c $(SRC)/game/rec.c \
              $(SRC)/game/unit.c \
              $(SRC)/game/svc.c $(SRC)/game/vm.c $(SRC)/game/res.c \
              $(SRC)/game/bgm.c $(SRC)/game/scene.c $(SRC)/game/fade.c \
              $(SRC)/game/kbd.c $(SRC)/game/map.c $(SRC)/game/anim.c \
              $(SRC)/game/fx.c $(SRC)/game/msg.c $(SRC)/game/ev.c \
              $(SRC)/game/ev2.c $(SRC)/game/ev3.c $(SRC)/game/ev4.c \
              $(SRC)/game/ev5.c \
              $(SRC)/game/guest_mem.c
HOST_SRCS  := $(SRC)/host.c $(SRC)/main_sokol.c $(SRC)/render_sokol.c \
              $(SRC)/sokol_impl.c $(SRC)/keylog.c $(SRC)/keys.c \
              $(SRC)/ail.c $(SRC)/xmidi.c $(SRC)/synth.c $(SRC)/dls.c \
              $(SRC)/audio_sokol.c $(SRC)/repl.c $(DOS_SRCS) $(GAME_SRCS)
HOST_CFLAGS := $(CFLAGS) -DSOKOL_GLCORE -I$(SRC) -I$(SOKOL)
HOST_LIBS  := -lX11 -lXi -lXcursor -lGL -lasound -ldl -lm

all: $(OUT)/letest-linux $(OUT)/platprobe-linux $(OUT)/doscheck-linux \
     $(OUT)/faultprobe32 $(OUT)/faultprobe64 \
     $(OUT)/fd2host-linux

$(OUT)/platprobe-linux: $(SRC)/platprobe.c $(SRC)/le.c $(SRC)/platform_posix.c $(SRC)/le.h $(SRC)/platform.h
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) -I$(SRC) -o $@ $(SRC)/platprobe.c $(SRC)/le.c $(SRC)/platform_posix.c

$(OUT)/letest-linux: $(SRC)/letest.c $(SRC)/le.c $(SRC)/platform_posix.c $(SRC)/le.h $(SRC)/platform.h
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) -I$(SRC) -o $@ $(SRC)/letest.c $(SRC)/le.c $(SRC)/platform_posix.c

# INT 21h services + low memory + a real `int 0x21` through sigaction.
# host_exit_after_remaining is stubbed in doscheck.c, so host.c stays out.
$(OUT)/doscheck-linux: $(SRC)/doscheck.c $(DOS_SRCS) $(SRC)/dos.h $(SRC)/dos_fault.h $(SRC)/le.h $(SRC)/platform.h
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) -I$(SRC) -o $@ $(SRC)/doscheck.c $(DOS_SRCS)

# Fault-model probes (docs/rounds/15-dos-and-faults.md):
#   faultprobe32 - freestanding i386 (compat mode, the game's real mode)
#   faultprobe64 - glibc x86-64 (compile/smoke architecture)
$(OUT)/faultprobe32: $(SRC)/faultprobe32.c
	@mkdir -p $(OUT)
	$(CC) $(PROBE32_CFLAGS) -o $@ $(SRC)/faultprobe32.c

$(OUT)/faultprobe64: $(SRC)/faultprobe64.c
	@mkdir -p $(OUT)
	$(CC) -O0 -g -Wall -o $@ $(SRC)/faultprobe64.c

$(OUT)/fd2host-linux: $(HOST_SRCS) $(SRC)/host.h $(SRC)/le.h $(SRC)/dos.h $(SRC)/platform.h $(SRC)/keys.h
	@mkdir -p $(OUT)
	$(CC) $(HOST_CFLAGS) -o $@ $(HOST_SRCS) $(HOST_LIBS)

# The real host: 32-bit, so it can execute the guest. Needs the i386 toolchain
# and 32-bit dev libraries, which do not ship by default:
#   sudo apt-get install gcc-multilib libc6-dev-i386 \
#     libx11-dev:i386 libxi-dev:i386 libxcursor-dev:i386 \
#     libgl1-mesa-dev:i386 libasound2-dev:i386
# (Verified working 2026-10-07; keep the package list for fresh machines.)
host32: $(HOST_SRCS) $(SRC)/host.h $(SRC)/le.h $(SRC)/dos.h $(SRC)/platform.h $(SRC)/keys.h
	@mkdir -p $(OUT)
	$(CC) $(HOST_CFLAGS) -m32 -o $(OUT)/fd2host-linux32 $(HOST_SRCS) $(HOST_LIBS)

run: $(OUT)/letest-linux
	$(OUT)/letest-linux $(GAME) $(REFDIR)

clean:
	rm -f $(OUT)/letest-linux $(OUT)/platprobe-linux $(OUT)/doscheck-linux \
	      $(OUT)/faultprobe32 $(OUT)/faultprobe64

.PHONY: all run clean
